---
import { execSync } from 'node:child_process';
import { Icon } from 'astro-icon/components';
import ContentBox from '@common/ContentBox.astro';
import BurstDivider from '@common/BurstDivider.astro';
import { getEmail, getSocials } from '@services/myData';

const REPOSITORY = 'https://github.com/wbmagalhaes/wbmagalhaes.github.io';

function buildCommit() {
  try {
    return execSync('git rev-parse HEAD', { encoding: 'utf8' }).trim();
  } catch {
    return import.meta.env.GITHUB_SHA ?? process.env.GITHUB_SHA ?? '';
  }
}

const commit = buildCommit();

const END_BURST = Array.from({ length: 28 }, (_, i) => {
  const angle = (i / 28) * Math.PI * 2;
  const radius = i % 2 ? 58 : 80;
  return `${(90 + Math.cos(angle) * radius).toFixed(1)},${(80 + Math.sin(angle) * radius * 0.75).toFixed(1)}`;
}).join(' ');

const email = getEmail();
const socials = getSocials();

const sections = [
  { name: 'About me', href: '/#about' },
  { name: 'Skills', href: '/#skills' },
  { name: 'Experience', href: '/#experience' },
  { name: 'Contact', href: '/#contact' },
];

const tools = [
  { name: 'Astro', icon: 'simple-icons:astro', link: 'https://astro.build/' },
  { name: 'Tailwind', icon: 'simple-icons:tailwindcss', link: 'https://tailwindcss.com/' },
  { name: 'React', icon: 'simple-icons:react', link: 'https://react.dev/' },
];

type Props = {
  edge?: boolean;
};

const { edge = true } = Astro.props;
---

<footer class:list={['site-footer relative text-wm-hydrogen-100 pb-4', edge ? 'pt-12 md:pt-16' : 'pt-20 md:pt-32']}>
  {
    edge && (
      <BurstDivider color='var(--color-wm-nitrogen-800)' seed={8} />
    )
  }
  <svg class='the-end hidden 2xl:block absolute right-8 bottom-8 w-52 -rotate-6' viewBox='0 0 180 160' aria-hidden='true'>
    <polygon points={END_BURST} class='fill-wm-oxygen' stroke='black' stroke-width='4' stroke-linejoin='round' />
    <g class='font-comic' text-anchor='middle' fill='white' stroke='black' stroke-width='4' paint-order='stroke fill' stroke-linejoin='round'>
      <text x='90' y='76' font-size='30' letter-spacing='2'>The</text>
      <text x='90' y='108' font-size='38' letter-spacing='2' class='fill-wm-sun'>End?</text>
    </g>
  </svg>

  <ContentBox>
    <div class='grid grid-cols-2 md:grid-cols-[1.4fr_1fr_1fr] gap-8 md:gap-12'>
      <div class='col-span-2 md:col-span-1 flex flex-col items-start gap-4'>
        <a href='/#' class='block -skew-x-12 bg-white px-3 py-1 shadow-[3px_3px_0_0_var(--color-wm-oxygen)]'>
          <span class='block skew-x-12 font-comic uppercase whitespace-nowrap tracking-[0.1em] text-3xl leading-none text-black'>
            W.M. <span class='text-wm-oxygen'>Comics</span>
          </span>
        </a>
        <p class='font-lettering font-bold leading-snug text-wm-hydrogen-400 max-w-xs'>
          New issues whenever the compiler allows.
        </p>
      </div>

      <nav aria-label='Footer'>
        <h2 class='font-comic uppercase tracking-widest text-xl text-wm-sun [text-shadow:2px_2px_0_#000]'>Chapters</h2>
        <ul class='mt-3 flex flex-col gap-2 font-lettering font-bold'>
          {sections.map(({ name, href }, index) => (
            <li>
              <a href={href} class='group inline-flex items-baseline gap-2 transition-[translate,color] duration-150 hover:translate-x-1 hover:text-wm-sun'>
                <span class='font-comic text-wm-oxygen group-hover:text-wm-sun'>{index + 1}.</span>
                {name}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div>
        <h2 class='font-comic uppercase tracking-widest text-xl text-wm-sun [text-shadow:2px_2px_0_#000]'>Find me</h2>
        <ul class='mt-3 flex flex-col gap-2 font-lettering font-bold'>
          <li>
            <a href={`mailto:${email}`} class='inline-flex items-center gap-2 transition-[translate,color] duration-150 hover:translate-x-1 hover:text-wm-sun'>
              <Icon name='ic:outline-email' class='size-5' />Email
            </a>
          </li>
          {socials.map(({ name, link }) => (
            <li>
              <a href={link} target='_blank' rel='noreferrer' class='inline-flex items-center gap-2 transition-[translate,color] duration-150 hover:translate-x-1 hover:text-wm-sun'>
                <Icon name={`simple-icons:${name.toLowerCase()}`} class='size-5' />{name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class='mt-10 pt-3 border-t-2 border-wm-hydrogen-100/15 flex flex-col md:flex-row md:items-center justify-between gap-3 text-sm font-lettering font-bold text-wm-hydrogen-500'>
      <p>© {new Date().getFullYear()} William Magalhães</p>
      <p class='flex flex-wrap items-center gap-x-3 gap-y-1'>
        <span>Built with</span>
        {tools.map(({ name, icon, link }) => (
          <a href={link} target='_blank' rel='noreferrer' class='inline-flex items-center gap-1 hover:text-wm-sun'>
            <Icon name={icon} class='size-4' />{name}
          </a>
        ))}
        {commit && (
          <a href={`${REPOSITORY}/commit/${commit}`} target='_blank' rel='noreferrer' class='inline-flex items-center gap-1 font-mono hover:text-wm-sun'>
            v{commit.slice(0, 7)}
          </a>
        )}
      </p>
    </div>
  </ContentBox>
</footer>

<style>
  .site-footer {
    background-color: var(--color-wm-nitrogen-800);
  }

  .the-end {
    transition: rotate 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .the-end:hover {
    rotate: 4deg;
  }


</style>
