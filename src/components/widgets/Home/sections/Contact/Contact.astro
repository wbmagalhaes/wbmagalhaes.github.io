---
import { Icon } from 'astro-icon/components';
import ContentBox from '@common/ContentBox.astro';
import PostageStamp from '@common/PostageStamp.astro';
import { getHomeEntry } from '@services/home';
import { getEmail, getSocials, getWorks } from '@services/myData';

const email = getEmail();
const socials = getSocials();
const { entry, Content } = await getHomeEntry('contact');
const pageNumber = 3 + getWorks().length;

const stamps = [
  { name: 'Email', link: `mailto:${email}`, icon: 'ic:outline-email', color: 'var(--color-wm-oxygen)', external: false },
  ...socials.map((social, index) => ({
    name: social.name,
    link: social.link,
    icon: `simple-icons:${social.name.toLowerCase()}`,
    color: ['var(--color-wm-sky)', 'var(--color-wm-leaf)', 'var(--color-wm-sun)'][index % 3],
    external: true,
  })),
];
---

<section id='contact' class='contact relative z-10 pt-20 md:pt-26 pb-20 md:pb-26'>
  <div class='drop-overlay absolute pointer-events-none' data-desk-overlay aria-hidden='true'>
    <span class='sent-sfx absolute top-3 right-4 md:top-5 md:right-8 rotate-6'>Sent!</span>
  </div>

  <div class='contact-paper absolute inset-0 -z-10' aria-hidden='true'></div>
  <ContentBox>
    <div class='comic-page'>
      <div data-stagger class='grid grid-cols-1 md:grid-cols-12 gap-3 md:gap-4'>
        <header data-stagger-item class='comic-panel zigzag md:col-span-12 bg-wm-sun p-5 md:p-8 grid lg:grid-cols-[auto_1fr] items-center gap-6 lg:gap-10'>
          <div class='flex flex-col items-start gap-3'>
            <p class='comic-caption bg-white'>Letters to the editor</p>
            <h2 class='comic-headline text-5xl md:text-7xl'>{entry.data.title}</h2>
          </div>
          <div class='letter bg-white border-[3px] border-black p-4 md:p-5 font-lettering font-bold leading-snug -rotate-1'>
            <Content />
          </div>
        </header>


        <div data-stagger-item class='comic-panel desk relative md:col-span-12 lg:col-span-7 p-5 md:p-6 flex flex-col justify-center gap-5'>
          <svg data-envelope class='envelope w-full max-w-md self-center -rotate-2 overflow-visible transition-[scale] duration-150' viewBox='0 0 300 190' role='img' aria-label='Air mail envelope addressed to William Magalhães'>
            <defs>
              <pattern id='airmail' width='28' height='28' patternUnits='userSpaceOnUse' patternTransform='rotate(45)'>
                <rect width='14' height='28' class='fill-wm-oxygen' />
                <rect x='14' width='14' height='28' class='fill-wm-nitrogen' />
              </pattern>
            </defs>
            <rect x='5' y='5' width='300' height='190' rx='5' fill='black' />
            <rect x='2' y='2' width='296' height='186' rx='4' fill='url(#airmail)' stroke='black' stroke-width='4' />
            <rect x='12' y='12' width='276' height='166' fill='white' stroke='black' stroke-width='2' />

            <g class='font-lettering' font-weight='700' fill='black'>
              <text x='24' y='34' font-size='9' letter-spacing='1'>FROM: YOU</text>
              <text x='24' y='46' font-size='9' letter-spacing='1'>SOMEWHERE ON EARTH</text>
            </g>

            <g class='place-hint' aria-hidden='true'>
              <rect x='221' y='15' width='60' height='70' rx='3' fill='none' class='stroke-wm-oxygen' stroke-width='3' stroke-dasharray='6 4' />
            </g>
            <g data-slot transform='translate(228 22) rotate(3)'>
              <rect width='46' height='56' fill='white' stroke='black' stroke-width='1.5' stroke-dasharray='3 2' />
              <rect x='5' y='5' width='36' height='46' class='fill-wm-sun' stroke='black' stroke-width='2' />
              <text x='23' y='34' text-anchor='middle' class='font-comic' font-size='16'>42¢</text>
            </g>
            <g fill='none' stroke='black' stroke-width='1.5' opacity='0.75'>
              <circle cx='214' cy='56' r='19' />
              <circle cx='214' cy='56' r='14' />
              <path d='M236 44 q6 -4 12 0 t12 0 t12 0 M236 52 q6 -4 12 0 t12 0 t12 0 M236 60 q6 -4 12 0 t12 0 t12 0' />
            </g>
            <text x='214' y='59' text-anchor='middle' class='font-comic' font-size='8' opacity='0.75'>W.M.</text>

            <text x='22' y='88' class='font-comic' font-size='14' letter-spacing='2' fill='var(--color-wm-oxygen)'>PAR AVION · AIR MAIL</text>

            <g class='font-lettering' font-weight='700' font-size='13' letter-spacing='0.5'>
              <text x='96' y='122'>TO: WILLIAM MAGALHÃES</text>
              <text x='96' y='140'>W.M. COMICS HQ</text>
              <text x='96' y='158'>THE INTERNET</text>
            </g>
            <g stroke='black' stroke-width='1' opacity='0.35'>
              <line x1='96' y1='126' x2='276' y2='126' />
              <line x1='96' y1='144' x2='276' y2='144' />
              <line x1='96' y1='162' x2='276' y2='162' />
            </g>
            <g class='place-hint place-label-svg' transform='translate(251 104) rotate(-4)'>
              <path d='M-48 -13 H-8 L0 -22 L8 -13 H48 V13 H-48 Z' class='fill-wm-oxygen' stroke='black' stroke-width='3' stroke-linejoin='round' />
              <text y='6' text-anchor='middle' class='font-comic' font-size='15' letter-spacing='1' fill='white'>PLACE HERE!</text>
            </g>
          </svg>
        </div>

        <div data-stagger-item class='comic-panel album md:col-span-12 lg:col-span-5 p-5 md:p-6 flex flex-col gap-4'>
          <p class='comic-caption self-start'>Pick and place a stamp</p>
          <ul class='flex-1 w-full max-w-md lg:max-w-none mx-auto grid grid-cols-3 items-center gap-3 md:gap-4'>
            {
              stamps.map(({ name, link, icon, color, external }, index) => (
                <li class:list={[index % 2 ? 'rotate-3' : '-rotate-3']}>
                  <button
                    type='button'
                    data-stamp
                    data-href={link}
                    data-external={external ? 'true' : undefined}
                    aria-label={`Send via ${name}`}
                    class='stamp-link block w-full touch-none cursor-grab active:cursor-grabbing'
                  >
                    <PostageStamp color={color}>
                      <Icon name={icon} class='size-8 md:size-9' />
                      <span class='font-comic uppercase tracking-wider text-sm md:text-base leading-none'>{name}</span>
                    </PostageStamp>
                  </button>
                </li>
              ))
            }
          </ul>
        </div>

        {
          entry.data.subtitle && (
            <div data-stagger-item class='comic-panel hatched md:col-span-12 bg-wm-nitrogen flex justify-center px-5 py-8 md:py-10'>
              <p class='comic-headline text-center text-3xl md:text-5xl'>{entry.data.subtitle}</p>
            </div>
          )
        }
      </div>

      <footer class='pt-2 md:pt-3 text-right font-comic tracking-widest text-lg leading-none'>{pageNumber}</footer>
    </div>
  </ContentBox>
</section>

<script>
  const envelope = document.querySelector<SVGElement>('[data-envelope]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const slot = envelope?.querySelector<SVGGElement>('[data-slot]');
  const section = document.querySelector<HTMLElement>('#contact');
  const sentSfx = document.querySelector<HTMLElement>('[data-desk-overlay] .sent-sfx');

  const deskOverlay = document.querySelector<HTMLElement>('[data-desk-overlay]');
  const desk = document.querySelector<HTMLElement>('#contact .desk');

  function cover(target: HTMLElement | null, element: Element | null | undefined) {
    if (!target || !element || !section) return;
    const box = element.getBoundingClientRect();
    const origin = section.getBoundingClientRect();
    target.style.left = `${box.left - origin.left}px`;
    target.style.top = `${box.top - origin.top}px`;
    target.style.width = `${box.width}px`;
    target.style.height = `${box.height}px`;
  }

  function placeOverlay() {
    cover(deskOverlay, desk);
  }
  let landing = false;

  function land(stamp: HTMLElement, offset: { x: number; y: number }) {
    if (!slot) {
      send(stamp);
      return;
    }
    landing = true;
    const from = stamp.getBoundingClientRect();
    const to = slot.getBoundingClientRect();
    const dx = offset.x + to.left + to.width / 2 - (from.left + from.width / 2);
    const dy = offset.y + to.top + to.height / 2 - (from.top + from.height / 2);
    stamp.classList.add('landing');
    stamp.style.translate = `${dx}px ${dy}px`;
    stamp.style.scale = String((to.height / from.height) * 1.15);

    placeOverlay();
    window.setTimeout(() => {
      envelope?.classList.add('stamped');
      if (envelope && !reduceMotion) {
        const env = envelope.getBoundingClientRect();
        const own = stamp.getBoundingClientRect();
        const cx = env.left + env.width / 2;
        const cy = env.top + env.height / 2;
        const qx = own.left + own.width / 2;
        const qy = own.top + own.height / 2;
        const base = Number(stamp.style.scale) || 1;
        const frame = (k: number) =>
          `translate(${(((k - 1) * (qx - cx)) / base).toFixed(2)}px, ${(((k - 1) * (qy - cy)) / base).toFixed(2)}px) scale(${k})`;
        stamp.animate(
          [
            { transform: frame(1), offset: 0, easing: 'ease-out' },
            { transform: frame(0.95), offset: 0.3, easing: 'ease-out' },
            { transform: frame(1.03), offset: 0.65, easing: 'ease-out' },
            { transform: frame(1), offset: 1 },
          ],
          { duration: 350 },
        );
      }
      sentSfx?.classList.add('show');
    }, 380);

    window.setTimeout(() => send(stamp), 900);

    window.setTimeout(() => {
      stamp.classList.remove('landing');
      stamp.style.translate = '';
      stamp.style.scale = '';
      stamp.closest('li')?.classList.remove('lifted');
      stamp.closest('.comic-panel')?.classList.remove('lifted');
      envelope?.classList.remove('stamped', 'drop-ready');
      sentSfx?.classList.remove('show');
      landing = false;
    }, 1300);
  }

  function send(stamp: HTMLElement) {
    const href = stamp.dataset.href;
    if (!href) return;
    if (stamp.dataset.external) window.open(href, '_blank', 'noopener');
    else window.location.href = href;
  }

  function overEnvelope(x: number, y: number) {
    if (!envelope) return false;
    const rect = envelope.getBoundingClientRect();
    return x >= rect.left && x <= rect.right && y >= rect.top && y <= rect.bottom;
  }

  document.querySelectorAll<HTMLElement>('[data-stamp]').forEach((stamp) => {
    let start = { x: 0, y: 0 };
    let dragging = false;

    stamp.addEventListener('pointerdown', (event) => {
      if (landing) return;
      dragging = true;
      start = { x: event.clientX, y: event.clientY };
      stamp.setPointerCapture(event.pointerId);
      stamp.classList.add('dragging');
      envelope?.classList.add('awaiting');
      placeOverlay();
      stamp.closest('li')?.classList.add('lifted');
      stamp.closest('.comic-panel')?.classList.add('lifted');
    });

    let pointer = { x: 0, y: 0 };
    let frame = 0;
    let wasReady = false;

    function follow() {
      frame = 0;
      stamp.style.translate = `${pointer.x - start.x}px ${pointer.y - start.y}px`;
      const ready = overEnvelope(pointer.x, pointer.y);
      if (ready !== wasReady) {
        envelope?.classList.toggle('drop-ready', ready);
        wasReady = ready;
      }
    }

    stamp.addEventListener('pointermove', (event) => {
      if (!dragging) return;
      pointer = { x: event.clientX, y: event.clientY };
      if (!frame) frame = requestAnimationFrame(follow);
    });

    stamp.addEventListener('pointerup', (event) => {
      if (!dragging) return;
      dragging = false;
      cancelAnimationFrame(frame);
      frame = 0;
      wasReady = false;
      stamp.classList.remove('dragging');
      envelope?.classList.remove('awaiting');
      if (overEnvelope(event.clientX, event.clientY)) {
        envelope?.classList.add('drop-ready');
        land(stamp, { x: event.clientX - start.x, y: event.clientY - start.y });
        return;
      }
      envelope?.classList.remove('drop-ready');
      stamp.closest('li')?.classList.remove('lifted');
      stamp.closest('.comic-panel')?.classList.remove('lifted');
      stamp.style.translate = '';
    });

    stamp.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        send(stamp);
      }
    });
  });
</script>

<style>
  .contact {
    background: linear-gradient(var(--color-wm-nitrogen-700) 50%, var(--color-wm-nitrogen-800) 50%);
  }

  .contact-paper {
    transform: skewY(-1.5deg);
    box-shadow:
      0 -4px 0 black,
      0 4px 0 black,
      0 -12px 0 rgb(0 0 0 / 0.4),
      0 12px 0 rgb(0 0 0 / 0.4);
    background-color: var(--color-wm-hydrogen-100);
    background-image: repeating-linear-gradient(
      -45deg,
      rgb(230 57 70 / 0.35) 0 40px,
      transparent 40px 80px,
      rgb(29 53 87 / 0.35) 80px 120px,
      transparent 120px 160px
    );
  }

  .contact-paper::before,
  .contact-paper::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 0;
    border-top: 3px dashed black;
    pointer-events: none;
  }

  .contact-paper::before {
    top: 14px;
  }

  .contact-paper::after {
    bottom: 14px;
  }

  .letter :global(p + p) {
    margin-top: 0.75rem;
  }

  .zigzag {
    --zig: rgb(217 154 0 / 0.35);
    background-image:
      linear-gradient(135deg, var(--zig) 25%, transparent 25%),
      linear-gradient(225deg, var(--zig) 25%, transparent 25%),
      linear-gradient(315deg, var(--zig) 25%, transparent 25%),
      linear-gradient(45deg, var(--zig) 25%, transparent 25%);
    background-position: -12px 0, -12px 0, 0 0, 0 0;
    background-size: 24px 24px;
  }

  .hatched {
    background-image: repeating-linear-gradient(-45deg, var(--color-wm-nitrogen-700) 0 2px, transparent 2px 9px);
  }

  .desk {
    background-color: #b7804f;
    background-image:
      repeating-linear-gradient(
        180deg,
        rgb(92 52 20 / 0) 0,
        rgb(92 52 20 / 0.16) 1.5px,
        rgb(92 52 20 / 0) 3px 10px,
        rgb(92 52 20 / 0.09) 11px,
        rgb(92 52 20 / 0) 12px 23px
      ),
      linear-gradient(90deg, rgb(0 0 0 / 0.06), transparent 30%, transparent 70%, rgb(0 0 0 / 0.06));
  }

  .album {
    background-color: var(--color-wm-paper);
    background-image:
      linear-gradient(rgb(92 64 30 / 0.12) 1px, transparent 1px),
      linear-gradient(90deg, rgb(92 64 30 / 0.12) 1px, transparent 1px);
    background-size: 20px 20px;
  }

  .stamp-link {
    transition: translate 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .stamp-link.dragging,
  .stamp-link :global(.stamp-shadow) {
    transition: transform 0.3s ease-out;
  }

  .stamp-link.landing :global(.stamp-shadow) {
    transform: translate(1px, 1px);
  }

  .stamp-link.landing {
    will-change: translate, scale;
  }

  .stamp-link.dragging {
    position: relative;
    z-index: 50;
    transition: none;
    scale: 1.1;
  }

  .lifted {
    position: relative;
    z-index: 50;
  }

  .stamp-link.landing {
    position: relative;
    z-index: 50;
    transition:
      translate 0.38s cubic-bezier(0.3, 1.25, 0.5, 1),
      scale 0.38s cubic-bezier(0.3, 1.25, 0.5, 1);
  }

  .envelope.stamped {
    animation: envelope-thunk 0.35s ease-out;
  }

  @keyframes envelope-thunk {
    30% {
      transform: scale(0.95);
    }
    65% {
      transform: scale(1.03);
    }
  }

  .sent-sfx {
    font-family: var(--font-comic);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 2.5rem;
    line-height: 1;
    color: var(--color-wm-sun);
    -webkit-text-stroke: 1.5px black;
    paint-order: stroke fill;
    text-shadow: 3px 3px 0 black;
    opacity: 0;
    scale: 0.5;
  }

  .sent-sfx.show {
    animation: sent-pop 0.9s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  @keyframes sent-pop {
    0% {
      opacity: 0;
      scale: 0.5;
    }
    30%,
    80% {
      opacity: 1;
      scale: 1.1;
    }
    100% {
      opacity: 0;
      scale: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stamp-link.landing {
      transition: none;
    }

    .envelope.stamped {
      animation: none;
    }
  }

  .place-hint {
    opacity: 0;
    transition: opacity 0.15s ease-out;
  }

  .envelope.awaiting .place-hint {
    opacity: 1;
  }

  .drop-overlay {
    z-index: 60;
  }



  .envelope.drop-ready {
    scale: 1.04;
  }

</style>
