---
import ContentBox from '@common/ContentBox.astro';
import CoverCircuit from './CoverCircuit';
import { getHomeEntry } from '@services/home';

const { entry } = await getHomeEntry('hero');
const balloons = entry.data.balloons ?? [];

const balloonStyles = [
  {
    place: 'self-start md:mt-8',
    box: 'max-w-[17rem] bg-wm-sun px-3 py-2',
    tail: null,
  },
  {
    place: 'self-start md:ml-12 lg:ml-28',
    box: 'bg-white max-w-md rounded-[1.25rem] px-5 py-3',
    tail: 'left-16 -bottom-[34px]',
  },
  {
    place: 'self-end md:mr-4 md:-mt-8',
    box: 'bg-white max-w-[14rem] rounded-[1.25rem] px-4 py-2',
    tail: 'right-10 -bottom-[34px] -scale-x-100',
  },
  {
    place: 'self-start md:ml-8',
    box: 'bg-white max-w-sm rounded-[1.25rem] px-5 py-3',
    tail: 'right-12 -bottom-[34px] -scale-x-100',
  },
];

const barWidths = [...'0425162637485961'].flatMap((digit) => {
  const n = Number(digit);
  return [1 + (n % 3), 1 + ((n + 1) % 2), 1 + ((n * 7) % 4), 1 + ((n + 2) % 2)];
});
const bars = barWidths.reduce<{ x: number; w: number; bar: boolean }[]>((acc, w, i) => {
  const last = acc.at(-1);
  acc.push({ x: last ? last.x + last.w : 0, w, bar: i % 2 === 0 });
  return acc;
}, []);
const barcodeWidth = barWidths.reduce((sum, w) => sum + w, 0);

const stampHoles = [0, 1, 2, 3, 4, 5, 6, 7, 8].flatMap((i) => [
  { x: i * 10, y: 0 },
  { x: i * 10, y: 100 },
]).concat([1, 2, 3, 4, 5, 6, 7, 8, 9].flatMap((i) => [
  { x: 0, y: i * 10 },
  { x: 80, y: i * 10 },
]));

const BURST_SPIKES = 14;

const burst = Array.from({ length: BURST_SPIKES * 2 }, (_, i) => {
  const radius = i % 2 === 0 ? 50 : 36 + (i % 4) * 2;
  const angle = (Math.PI * i) / BURST_SPIKES - Math.PI / 2;
  return `${(50 + radius * Math.cos(angle)).toFixed(1)},${(50 + radius * Math.sin(angle)).toFixed(1)}`;
}).join(' ');
---

<section class='hero relative overflow-hidden -mt-32 pt-32 pb-20 md:pb-26'>
  <ContentBox class='relative flex flex-col md:min-h-[max(38rem,calc(100svh-14.5rem))] py-3 md:py-4 md:pt-8'>
    <div class='page relative flex-1 flex flex-col'>
      <div class='panel panel-title relative isolate flex-1 bg-wm-nitrogen flex flex-col p-3 pb-14 md:p-4 md:pb-16'>
        <div class='absolute inset-0 -z-10 overflow-hidden'>
          <CoverCircuit />
        </div>
        <div class='flex items-start gap-2 md:gap-3'>
          <div class='corner-box shrink-0 w-16 md:w-20 bg-white border-[3px] border-black text-center font-bold uppercase leading-none'>
            <div class='border-b-[3px] border-black px-1 py-1 text-[0.5rem] md:text-[0.6rem] tracking-wider'>W.M.<br />Comics</div>
            <div class='py-1 border-b-[3px] border-black'>
              <div class='font-title text-2xl md:text-3xl'>01</div>
              <div class='text-[0.55rem] md:text-xs tracking-widest'>Nov</div>
            </div>
            <svg class='mx-auto my-1 size-8 md:size-10' viewBox='0 0 24 24' aria-hidden='true'>
              <g fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='2'>
                <path d='M19 6.873a2 2 0 0 1 1 1.747v6.536a2 2 0 0 1-1.029 1.748l-6 3.833a2 2 0 0 1-1.942 0l-6-3.833A2 2 0 0 1 4 15.157V8.62a2 2 0 0 1 1.029-1.748l6-3.572a2.056 2.056 0 0 1 2 0l6 3.573H19z' />
                <path class='origin-center' transform='scale(0.8)' d='m9 8l1 8l2-5l2 5l1-8' />
              </g>
            </svg>
            <div class='bg-wm-oxygen border-t-[3px] border-black py-1 font-title text-lg md:text-xl text-white [text-shadow:2px_2px_0_#000]'>42¢</div>
          </div>

          <div class='flex-1'></div>

          <div class='seal shrink-0 self-start w-20 md:w-24 -rotate-3' role='img' aria-label='Approved by the compiler, 0 errors'>
            <svg class='block w-full' viewBox='0 0 80 100' aria-hidden='true'>
              <mask id='stamp-holes'>
                <rect width='80' height='100' fill='white' />
                {stampHoles.map((h) => <circle cx={h.x} cy={h.y} r='3.2' fill='black' />)}
              </mask>
              <rect width='80' height='100' fill='white' mask='url(#stamp-holes)' />
              <rect x='8' y='8' width='64' height='84' fill='none' stroke='black' stroke-width='2' />
              <g class='font-title' font-weight='700' text-anchor='middle' fill='black'>
                <text x='40' y='24' font-size='9' letter-spacing='0.5'>APPROVED</text>
                <text x='40' y='34' font-size='6.5' letter-spacing='1'>BY THE</text>
                <text x='40' y='47' font-size='10.5'>COMPILER</text>
              </g>
              <circle cx='40' cy='62' r='8' fill='none' stroke='black' stroke-width='2' />
              <path d='M35.5 62 L38.8 65.3 L44.5 58.8' fill='none' stroke='black' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round' />
              <text x='40' y='84' class='font-title' font-weight='700' font-size='7' letter-spacing='1' text-anchor='middle'>0 ERRORS</text>
            </svg>
          </div>
        </div>

        <div class='title-block flex flex-col -mt-10 md:-mt-12 md:px-24'>
          <h1 class='name font-comic uppercase text-center md:whitespace-nowrap leading-[0.9] tracking-wide text-wm-sun text-[3.25rem] md:text-[clamp(2.5rem,7.6vw,7rem)]'>
            {entry.data.title}
          </h1>
          <div class='tagline -skew-x-12 bg-black px-4 py-1 md:px-6 md:py-1.5 mt-4 md:mt-3 mx-auto md:mr-0'>
            <div class='skew-x-12 font-comic uppercase tracking-[0.12em] text-base md:text-2xl leading-none text-white'>
              The <span class='text-wm-sun'>full-stack</span> adventures begin!
            </div>
          </div>
        </div>

        <div class='flex-1 min-h-0 flex flex-col items-start gap-6 pt-6 md:pt-16 pb-12 md:pb-10 md:pl-12 lg:pl-[5.75rem] md:w-[64%]'>

          <ul class='balloons flex flex-col gap-9 md:gap-10 w-full'>
            {balloons.map((text, i) => {
              const style = balloonStyles[i % balloonStyles.length];
              return (
                <li class:list={['balloon relative', style.place]} style={`--i: ${i}`}>
                  {style.tail && (
                    <svg class:list={['tail-back absolute w-10 h-12', style.tail]} viewBox='0 0 40 48' aria-hidden='true'>
                      <path d='M6 0 L10 46 L30 0 Z' fill='white' stroke='black' stroke-width='6' stroke-linejoin='round' />
                    </svg>
                  )}
                  <div class:list={['relative border-[3px] border-black font-lettering font-bold uppercase text-sm md:text-base leading-tight tracking-wide', style.box]}>{text}</div>
                  {style.tail && (
                    <svg class:list={['tail-front absolute w-10 h-12', style.tail]} viewBox='0 0 40 48' aria-hidden='true'>
                      <path d='M6 0 L10 46 L30 0 Z' fill='white' />
                    </svg>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
        <div class='absolute left-3 bottom-14 md:left-4 md:bottom-16 w-16 h-36 hidden md:block'>
        <div class='barcode absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 -rotate-90 flex bg-white border-[3px] border-black p-1.5' aria-hidden='true'>
          <div class='flex flex-col'>
            <span class='text-[0.45rem] font-bold uppercase tracking-wider leading-none pb-0.5'>Direct sales</span>
            <svg class='h-10 w-28' viewBox={`0 0 ${barcodeWidth} 40`} preserveAspectRatio='none'>
              {bars.filter((b) => b.bar).map((b) => <rect x={b.x} y='0' width={b.w} height='40' fill='black' />)}
            </svg>
            <div class='flex justify-between text-[0.5rem] font-bold leading-none pt-0.5'>
              <span>7</span><span>25112</span><span>02601</span><span>1</span>
            </div>
          </div>
        </div>
        </div>
        <div class='burst absolute hidden md:block md:top-[21rem] md:right-8 lg:right-28 md:w-40 lg:w-48 rotate-12' aria-hidden='true'>
          <div class='relative aspect-square'>
            <div class='absolute inset-0 scale-y-[0.8]'>
              <svg viewBox='0 0 100 100' class='burst-spin absolute inset-0 size-full overflow-visible translate-x-[3px] translate-y-[3px]'>
                <polygon points={burst} fill='black' />
              </svg>
              <svg viewBox='0 0 100 100' class='burst-spin absolute inset-0 size-full overflow-visible'>
                <polygon points={burst} class='fill-wm-oxygen' stroke='black' stroke-width='2' stroke-linejoin='round' />
              </svg>
            </div>
            <svg viewBox='0 0 100 100' class='absolute inset-0 size-full overflow-visible'>
              <g class='font-terminal' font-size='17' text-anchor='middle' fill='white' stroke='white' stroke-width='0.7' stroke-linejoin='miter'>
                <text x='50' y='47'>HELLO,</text>
                <text x='50' y='62'>WORLD!</text>
              </g>
            </svg>
          </div>
        </div>
        <div class='absolute inset-x-0 bottom-0 flex items-center justify-between gap-4 bg-black px-4 md:px-6 h-10 md:h-12 font-comic uppercase tracking-[0.15em] text-white text-base md:text-xl'>
          <span><span class='text-wm-sun'>William Magalhães</span> #01</span>
          <span class='hidden sm:inline text-sm md:text-base tracking-widest'>wbmagalhaes.github.io</span>
        </div>
      </div>

      <div class='inset-wrap relative mt-4 md:mt-0 md:absolute md:right-4 md:bottom-16 z-10 transition-[translate] duration-200 ease-out hover:translate-x-1.5'>
        <a href='#about' aria-label='To be continued: About me' class='panel panel-next group relative block px-5 py-3 pr-12 md:px-6 md:py-4 md:pr-14'>
          <span class='arrow-edge absolute inset-0' aria-hidden='true'>
            <span class='arrow-fill absolute inset-[3px] bg-wm-oxygen'></span>
          </span>
          <span class='relative block whitespace-nowrap font-comic uppercase tracking-[0.08em] text-2xl md:text-3xl leading-none text-wm-hydrogen-100 [text-shadow:2px_2px_0_#000]'>
            To be continued
          </span>
        </a>
      </div>
    </div>
  </ContentBox>
</section>

<style>
  .hero {
    background-color: var(--color-wm-sun-300);
    background-image:
      radial-gradient(ellipse farthest-corner at 50% 45%, rgb(255 229 138 / 0) 0%, var(--color-wm-sun-300) 100%),
      repeating-conic-gradient(
      from 0deg at 50% 45%,
      var(--color-wm-sun-300) 0deg 5deg,
      var(--color-wm-sun) 5deg 10deg
    );
  }

  .panel {
    border: 3px solid black;
    animation: panel-in 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  .panel-title {
    box-shadow: 8px 8px 0 0 black;
    animation-delay: 0.05s;
  }

  .panel-story {
    animation-delay: 0.2s;
  }

  .panel-next {
    border: none;
    animation: arrow-in 0.6s cubic-bezier(0.22, 1.2, 0.36, 1) 0.9s both;
  }

  .inset-wrap {
    filter: drop-shadow(5px 5px 0 black);
  }

  .arrow-edge {
    background: black;
    clip-path: polygon(0 0, calc(100% - 2.25rem) 0, 100% 50%, calc(100% - 2.25rem) 100%, 0 100%);
  }

  .arrow-fill {
    clip-path: polygon(0 0, calc(100% - 2.15rem) 0, calc(100% - 0.2rem) 50%, calc(100% - 2.15rem) 100%, 0 100%);
  }

  .tagline {
    box-shadow: 5px 5px 0 0 var(--color-wm-oxygen);
  }

  .name {
    -webkit-text-stroke: 2px black;
    paint-order: stroke fill;
    transform: skew(-8deg) rotate(-2deg);
    transform-origin: center;
    text-shadow:
      1px 1px 0 var(--color-wm-oxygen),
      2px 2px 0 var(--color-wm-oxygen),
      3px 3px 0 var(--color-wm-oxygen),
      4px 4px 0 var(--color-wm-oxygen),
      5px 5px 0 var(--color-wm-oxygen),
      6px 6px 0 black,
      7px 7px 0 black;
  }

  .burst-spin {
    will-change: rotate;
    animation: burst-spin 40s linear infinite;
  }

  @keyframes burst-spin {
    to {
      rotate: 360deg;
    }
  }

  .burst {
    animation: burst-in 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) 0.7s both;
  }

  .balloon {
    animation: panel-in 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    animation-delay: calc(0.5s + var(--i) * 0.15s);
  }

  @keyframes arrow-in {
    from {
      opacity: 0;
      translate: -50% 0;
    }
  }

  @keyframes panel-in {
    from {
      opacity: 0;
      scale: 0.94;
      translate: 0 12px;
    }
  }

  @keyframes burst-in {
    from {
      opacity: 0;
      scale: 0.2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel,
    .balloon,
    .burst,
    .burst-spin {
      animation: none;
    }
  }
</style>
