---
type Props = {
  color: string;
  class?: string;
};

const { color, class: className } = Astro.props;

const RING_RADIUS = 22;
const BOND = 22;

type Point = { x: number; y: number };

const polar = (center: Point, radius: number, degrees: number): Point => ({
  x: center.x + radius * Math.cos((degrees * Math.PI) / 180),
  y: center.y + radius * Math.sin((degrees * Math.PI) / 180),
});

const lerp = (a: Point, b: Point, t: number): Point => ({ x: a.x + (b.x - a.x) * t, y: a.y + (b.y - a.y) * t });

const segment = (a: Point, b: Point) => `M${a.x.toFixed(1)} ${a.y.toFixed(1)} L${b.x.toFixed(1)} ${b.y.toFixed(1)}`;

function ring(center: Point, rotation: number, doubleEdges: number[]) {
  const vertices = Array.from({ length: 6 }, (_, k) => polar(center, RING_RADIUS, rotation + k * 60));
  const outline = vertices.map((v, k) => segment(v, vertices[(k + 1) % 6]));
  const doubles = doubleEdges.map((k) => {
    const a = lerp(center, vertices[k], 0.76);
    const b = lerp(center, vertices[(k + 1) % 6], 0.76);
    return segment(lerp(a, b, 0.15), lerp(a, b, 0.85));
  });
  return { vertices, paths: [...outline, ...doubles] };
}

function chain(start: Point, direction: number, bonds: number) {
  const paths: string[] = [];
  let point = start;
  for (let i = 0; i < bonds; i++) {
    const next = polar(point, BOND, direction + (i % 2 ? -30 : 30));
    paths.push(segment(point, next));
    point = next;
  }
  return paths;
}

const TILE = { width: 240, height: 200 };
const APOTHEM = RING_RADIUS * Math.cos(Math.PI / 6);

const tile = [
  [...ring({ x: 40, y: 45 }, -90, [0, 2, 4]).paths, ...chain(polar({ x: 40, y: 45 }, RING_RADIUS, -30), -30, 3)],
  [...ring({ x: 155, y: 35 }, -60, [0, 2, 4]).paths],
  [
    ...ring({ x: 120, y: 120 }, -60, [0, 2, 4]).paths,
    ...ring(polar({ x: 120, y: 120 }, APOTHEM * 2, -30), -60, [1, 3]).paths,
  ],
  [...ring({ x: 212, y: 150 }, -90, [1, 3, 5]).paths],
  [...ring({ x: 40, y: 150 }, -60, [1, 3, 5]).paths, ...chain(polar({ x: 40, y: 150 }, RING_RADIUS, 60), 60, 2)],
].map((paths) => paths.join(' '));

---

<svg class={className} aria-hidden='true'>
  <defs>
    <pattern id='hydrocarbons' width={TILE.width} height={TILE.height} patternUnits='userSpaceOnUse'>
      <g fill='none' stroke={color} stroke-width='3' stroke-linecap='round' stroke-linejoin='round'>
        {tile.map((d) => <path d={d} />)}
      </g>
    </pattern>
    <linearGradient id='hydrocarbons-fade' x1='0' x2='1'>
      <stop offset='0.2' stop-color='black' />
      <stop offset='0.75' stop-color='white' />
    </linearGradient>
    <mask id='hydrocarbons-mask'>
      <rect width='100%' height='100%' fill='url(#hydrocarbons-fade)' />
    </mask>
  </defs>
  <rect width='100%' height='100%' fill='url(#hydrocarbons)' mask='url(#hydrocarbons-mask)' />
</svg>
