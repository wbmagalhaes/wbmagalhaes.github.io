---
type Props = {
  color: string;
  class?: string;
};

const { color, class: className } = Astro.props;

const WIDTH = 80;
const HEIGHT = 100;
const STEP = 10;

const holes = [
  ...Array.from({ length: WIDTH / STEP + 1 }, (_, i) => [
    { x: i * STEP, y: 0 },
    { x: i * STEP, y: HEIGHT },
  ]).flat(),
  ...Array.from({ length: HEIGHT / STEP - 1 }, (_, i) => [
    { x: 0, y: (i + 1) * STEP },
    { x: WIDTH, y: (i + 1) * STEP },
  ]).flat(),
];

const maskId = `stamp-${Math.random().toString(36).slice(2, 8)}`;
---

<div class:list={['relative aspect-[4/5]', className]}>
  <svg class='absolute inset-0 size-full overflow-visible' viewBox={`0 0 ${WIDTH} ${HEIGHT}`} aria-hidden='true'>
    <mask id={maskId}>
      <rect width={WIDTH} height={HEIGHT} fill='white' />
      {holes.map((h) => <circle cx={h.x} cy={h.y} r='3.2' fill='black' />)}
    </mask>
    <g transform='translate(3 3)'>
      <rect width={WIDTH} height={HEIGHT} fill='black' fill-opacity='0.5' mask={`url(#${maskId})`} />
    </g>
    <rect width={WIDTH} height={HEIGHT} fill='white' mask={`url(#${maskId})`} />
    <rect x='8' y='8' width={WIDTH - 16} height={HEIGHT - 16} fill={color} stroke='black' stroke-width='2' />
  </svg>
  <div class='absolute inset-[10%] flex flex-col items-center justify-center gap-1.5 text-center'>
    <slot />
  </div>
</div>
